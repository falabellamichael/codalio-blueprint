# Keep LF endings in tracked source so hashes and diffs stay stable across
# machines. The installer hashes asset bytes, so a CRLF conversion on checkout
# would change every sha256 and make the host refuse to inject the plug-in.
* text=auto eol=lf

*.js    text eol=lf
*.cjs   text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.md    text eol=lf

*.png   binary
*.zip   binary
